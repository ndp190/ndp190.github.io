{
  "name": "bookmark-reader-worker",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "predev": "npm run seed:local",
    "dev": "wrangler dev --env local --persist-to .wrangler/state",
    "dev:local": "npm run dev",
    "dev:remote": "wrangler dev",
    "deploy": "wrangler deploy",
    "tail": "wrangler tail",
    "seed:local": "bash scripts/seed-local.sh",
    "backfill:images:dry-run": "node scripts/backfill-images.mjs",
    "backfill:images": "node scripts/backfill-images.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.5.0",
    "@cloudflare/workers-types": "^4.20241218.0",
    "typescript": "^5.3.3",
    "vitest": "^2.1.0",
    "wrangler": "^3.99.0"
  },
  "dependencies": {
    "jose": "^5.2.0",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5"
  }
}
